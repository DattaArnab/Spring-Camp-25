{
    "data_config": {
        "data_root": "/kaggle/input/handgesture/Project_data",
        "input_size": [224, 224],
        "sequence_length": 30,
        "class_names": ["Left_Swipe", "Ma chuda", "Stop",  "Thumbs_Down", "Thumbs_Up"]
    },
    "model_config": {
        "lstm_hidden_size": 512,
